{
  "components": {
    "schemas": {
      "GeminiImageCandidate": {
        "additionalProperties": false,
        "description": "One candidate.",
        "properties": {
          "content": {
            "$ref": "#/components/schemas/GeminiImageOutputContent",
            "description": "Generated content."
          },
          "finishReason": {
            "description": "Why generation stopped.\n\n**Allowed values:**\n- `STOP`: Finished normally.\n- `MAX_TOKENS`: Hit the output token limit.\n- `SAFETY`: Stopped for safety reasons.\n- `PROHIBITED_CONTENT`: Prohibited content.\n- `IMAGE_SAFETY`: The generated image failed the safety check.\n- `IMAGE_PROHIBITED_CONTENT`: The generated image contains prohibited content.\n- `NO_IMAGE`: No image was generated; adjust the prompt and retry.\n- `OTHER`: Other reasons.",
            "enum": [
              "STOP",
              "MAX_TOKENS",
              "SAFETY",
              "PROHIBITED_CONTENT",
              "IMAGE_SAFETY",
              "IMAGE_PROHIBITED_CONTENT",
              "NO_IMAGE",
              "OTHER"
            ],
            "type": "string"
          },
          "index": {
            "description": "Candidate index, from 0.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "content",
          "index"
        ],
        "type": "object"
      },
      "GeminiImageConfig": {
        "additionalProperties": false,
        "description": "Image output config.",
        "properties": {
          "aspectRatio": {
            "description": "Output aspect ratio. When omitted, `1:1` for text-to-image and the input image's ratio for edits.\n\n**Allowed values:**\n- `1:1`: Square; 1024x1024 at 1K.\n- `2:3`: Portrait; 848x1264 at 1K.\n- `3:2`: Landscape; 1264x848 at 1K.\n- `3:4`: Portrait; 896x1200 at 1K.\n- `4:3`: Landscape; 1200x896 at 1K.\n- `4:5`: Portrait; 928x1152 at 1K.\n- `5:4`: Landscape; 1152x928 at 1K.\n- `9:16`: Vertical; 768x1376 at 1K.\n- `16:9`: Widescreen; 1376x768 at 1K.\n- `21:9`: Ultra-wide; 1584x672 at 1K.",
            "enum": [
              "1:1",
              "2:3",
              "3:2",
              "3:4",
              "4:3",
              "4:5",
              "5:4",
              "9:16",
              "16:9",
              "21:9"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "GeminiImageContent": {
        "additionalProperties": false,
        "description": "One turn of content.",
        "properties": {
          "role": {
            "description": "Author of the turn; default `user`.\n\n**Allowed values:**\n- `user`: The user.\n- `model`: The model (earlier replies in multi-turn edits).",
            "enum": [
              "user",
              "model"
            ],
            "type": "string"
          },
          "parts": {
            "description": "Content parts in order; each part sets exactly one of `text`, `inlineData` or `fileData`.",
            "items": {
              "$ref": "#/components/schemas/GeminiImagePart"
            },
            "type": "array"
          }
        },
        "required": [
          "parts"
        ],
        "type": "object"
      },
      "GeminiImageFileData": {
        "additionalProperties": false,
        "description": "Image link.",
        "properties": {
          "fileUri": {
            "description": "A publicly downloadable `https` image link.",
            "type": "string"
          }
        },
        "required": [
          "fileUri"
        ],
        "type": "object"
      },
      "GeminiImageGenerationConfig": {
        "additionalProperties": false,
        "description": "Generation config.",
        "properties": {
          "imageConfig": {
            "$ref": "#/components/schemas/GeminiImageConfig",
            "description": "Image output config."
          }
        },
        "type": "object"
      },
      "GeminiImageInlineData": {
        "additionalProperties": false,
        "description": "Inline image data.",
        "properties": {
          "mimeType": {
            "description": "Image MIME type.\n\n**Allowed values:**\n- `image/png`: PNG.\n- `image/jpeg`: JPEG.\n- `image/webp`: WebP.\n- `image/heic`: HEIC.\n- `image/heif`: HEIF.",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/heic",
              "image/heif"
            ],
            "type": "string"
          },
          "data": {
            "description": "Base64 image data (no `data:` prefix).",
            "type": "string"
          }
        },
        "required": [
          "mimeType",
          "data"
        ],
        "type": "object"
      },
      "GeminiImageOutputContent": {
        "additionalProperties": false,
        "description": "Model output content.",
        "properties": {
          "role": {
            "description": "Always `model`.\n\n**Allowed values:**\n- `user`: The user.\n- `model`: The model (earlier replies in multi-turn edits).",
            "enum": [
              "user",
              "model"
            ],
            "type": "string"
          },
          "parts": {
            "description": "Output parts: text and images in order.",
            "items": {
              "$ref": "#/components/schemas/GeminiImageOutputPart"
            },
            "type": "array"
          }
        },
        "required": [
          "role",
          "parts"
        ],
        "type": "object"
      },
      "GeminiImageOutputInlineData": {
        "additionalProperties": false,
        "description": "Image data.",
        "properties": {
          "mimeType": {
            "description": "Image MIME type, e.g. `image/png`.",
            "type": "string"
          },
          "data": {
            "description": "Base64 image data.",
            "type": "string"
          }
        },
        "required": [
          "mimeType",
          "data"
        ],
        "type": "object"
      },
      "GeminiImageOutputPart": {
        "additionalProperties": false,
        "description": "One output part.",
        "properties": {
          "text": {
            "description": "Text returned by the model.",
            "type": "string"
          },
          "inlineData": {
            "$ref": "#/components/schemas/GeminiImageOutputInlineData",
            "description": "A generated image."
          },
          "thought": {
            "description": "`true` when the part is part of the model's thinking, not the final result.",
            "type": "boolean"
          },
          "thoughtSignature": {
            "description": "Thought signature. For multi-turn edits, send the model's parts back in `contents` unchanged.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "GeminiImagePart": {
        "additionalProperties": false,
        "description": "One content part.",
        "properties": {
          "text": {
            "description": "Text (the prompt).",
            "type": "string"
          },
          "inlineData": {
            "$ref": "#/components/schemas/GeminiImageInlineData",
            "description": "An image inlined as Base64."
          },
          "fileData": {
            "$ref": "#/components/schemas/GeminiImageFileData",
            "description": "An image referenced by link."
          }
        },
        "type": "object"
      },
      "GeminiImageRequest": {
        "additionalProperties": false,
        "description": "Request body of generateContent.",
        "properties": {
          "contents": {
            "description": "Conversation content. A single-turn request has one `user` item; for multi-turn edits send the turns in order.",
            "items": {
              "$ref": "#/components/schemas/GeminiImageContent"
            },
            "type": "array"
          },
          "generationConfig": {
            "$ref": "#/components/schemas/GeminiImageGenerationConfig",
            "description": "Generation config."
          }
        },
        "required": [
          "contents"
        ],
        "type": "object"
      },
      "GeminiImageResponse": {
        "additionalProperties": false,
        "description": "generateContent response.",
        "properties": {
          "candidates": {
            "description": "Generated candidates, usually one.",
            "items": {
              "$ref": "#/components/schemas/GeminiImageCandidate"
            },
            "type": "array"
          },
          "usageMetadata": {
            "$ref": "#/components/schemas/GeminiImageUsage",
            "description": "Token usage."
          },
          "modelVersion": {
            "description": "Model version used.",
            "type": "string"
          },
          "responseId": {
            "description": "Response ID.",
            "type": "string"
          }
        },
        "required": [
          "candidates"
        ],
        "type": "object"
      },
      "GeminiImageTokenCount": {
        "additionalProperties": false,
        "description": "Tokens of one modality.",
        "properties": {
          "modality": {
            "description": "Modality.\n\n**Allowed values:**\n- `TEXT`: Text.\n- `IMAGE`: Images.",
            "enum": [
              "TEXT",
              "IMAGE"
            ],
            "type": "string"
          },
          "tokenCount": {
            "description": "Token count.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "modality",
          "tokenCount"
        ],
        "type": "object"
      },
      "GeminiImageUsage": {
        "additionalProperties": false,
        "description": "Token usage.",
        "properties": {
          "promptTokenCount": {
            "description": "Input tokens (text and images).",
            "format": "int64",
            "type": "integer"
          },
          "candidatesTokenCount": {
            "description": "Output tokens.",
            "format": "int64",
            "type": "integer"
          },
          "thoughtsTokenCount": {
            "description": "Thinking tokens.",
            "format": "int64",
            "type": "integer"
          },
          "totalTokenCount": {
            "description": "Total tokens.",
            "format": "int64",
            "type": "integer"
          },
          "promptTokensDetails": {
            "description": "Input tokens by modality.",
            "items": {
              "$ref": "#/components/schemas/GeminiImageTokenCount"
            },
            "type": "array"
          },
          "candidatesTokensDetails": {
            "description": "Output tokens by modality.",
            "items": {
              "$ref": "#/components/schemas/GeminiImageTokenCount"
            },
            "type": "array"
          }
        },
        "required": [
          "promptTokenCount",
          "candidatesTokenCount",
          "totalTokenCount"
        ],
        "type": "object"
      },
      "ImageAPIError": {
        "additionalProperties": false,
        "description": "Error details.",
        "properties": {
          "code": {
            "description": "Error code.",
            "type": "string"
          },
          "http_status": {
            "description": "HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "message": {
            "description": "Human-readable error message.",
            "type": "string"
          },
          "request_id": {
            "description": "Request ID; include it when reporting issues.",
            "type": "string"
          },
          "type": {
            "description": "Error type.\n\n**Allowed values:**\n- `invalid_request_error`: Invalid request.\n- `authentication_error`: Authentication failed.\n- `insufficient_balance_error`: Insufficient balance.\n- `permission_error`: Permission denied.\n- `rate_limit_error`: Rate limited.\n- `api_error`: Server or upstream error.",
            "enum": [
              "invalid_request_error",
              "authentication_error",
              "insufficient_balance_error",
              "permission_error",
              "rate_limit_error",
              "api_error"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "http_status",
          "message",
          "request_id",
          "type"
        ],
        "type": "object"
      },
      "ImageAPIErrorResponse": {
        "additionalProperties": false,
        "description": "Error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ImageAPIError",
            "description": "Error details."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "API Key created in the DreamTo console, sent as `Authorization: Bearer <API Key>`.",
        "scheme": "bearer",
        "type": "http"
      },
      "googApiKey": {
        "description": "As with Google, the DreamTo API Key can also be sent in the `x-goog-api-key` header.",
        "in": "header",
        "name": "x-goog-api-key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Nano Banana 2 Lite: fast, low-cost image generation and editing with the official Google generateContent API.",
    "title": "Gemini 3.1 Flash Lite Image",
    "version": "v1beta"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1beta/models/gemini-3.1-flash-lite-image:generateContent": {
      "post": {
        "description": "Follows the official Google `POST /v1beta/models/{model}:generateContent`: send the prompt and reference images in `contents`; generated images come back as Base64 in `candidates[].content.parts[].inlineData`, possibly alongside text. The request is synchronous and usually takes 5–60 seconds.",
        "operationId": "geminiImageGenerateContent",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Text to image": {
                  "description": "Send the prompt in `contents` and set the aspect ratio in `imageConfig`.",
                  "summary": "Text to image",
                  "value": {
                    "contents": [
                      {
                        "role": "user",
                        "parts": [
                          {
                            "text": "An elegant dessert in a fancy banana-themed restaurant, soft lighting, food photography"
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "imageConfig": {
                        "aspectRatio": "16:9"
                      }
                    }
                  }
                },
                "Edit an image (Base64)": {
                  "description": "Send the image to edit as Base64 in `inlineData` and describe the change in the prompt.",
                  "summary": "Edit an image (Base64)",
                  "value": {
                    "contents": [
                      {
                        "role": "user",
                        "parts": [
                          {
                            "text": "Replace the background with a neon street after rain; keep the person unchanged"
                          },
                          {
                            "inlineData": {
                              "mimeType": "image/png",
                              "data": "<BASE64_IMAGE_DATA>"
                            }
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "imageConfig": {
                        "aspectRatio": "1:1"
                      }
                    }
                  }
                },
                "Edit an image (image link)": {
                  "description": "Pass a public `https` image link in `fileData.fileUri`.",
                  "summary": "Edit an image (image link)",
                  "value": {
                    "contents": [
                      {
                        "role": "user",
                        "parts": [
                          {
                            "text": "Remove the stains on the top of the keyboard and keep everything else"
                          },
                          {
                            "fileData": {
                              "fileUri": "https://your-cdn.example.com/keyboard.png"
                            }
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "imageConfig": {
                        "aspectRatio": "4:3"
                      }
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/GeminiImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "candidates": [
                        {
                          "content": {
                            "role": "model",
                            "parts": [
                              {
                                "inlineData": {
                                  "mimeType": "image/png",
                                  "data": "<BASE64_IMAGE_DATA>"
                                }
                              }
                            ]
                          },
                          "finishReason": "STOP",
                          "index": 0
                        }
                      ],
                      "usageMetadata": {
                        "promptTokenCount": 18,
                        "candidatesTokenCount": 1120,
                        "totalTokenCount": 1138,
                        "promptTokensDetails": [
                          {
                            "modality": "TEXT",
                            "tokenCount": 18
                          }
                        ],
                        "candidatesTokensDetails": [
                          {
                            "modality": "IMAGE",
                            "tokenCount": 1120
                          }
                        ]
                      },
                      "modelVersion": "gemini-3.1-flash-lite-image",
                      "responseId": "8bQWadqLHo-vz7IPpLWdkQ4"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/GeminiImageResponse"
                }
              }
            },
            "description": "Content generated.",
            "headers": {
              "X-Request-Id": {
                "description": "ID of this request; include it when reporting issues.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "error": {
                        "code": "invalid_request",
                        "http_status": 400,
                        "message": "Invalid request.",
                        "request_id": "req_7c1e9a4b2d3f5a6b8c9d0e1f",
                        "type": "invalid_request_error"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ImageAPIErrorResponse"
                }
              }
            },
            "description": "Invalid request: a required parameter is missing, a value is invalid or a parameter is not supported. Not charged."
          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "http_status": 401,
                        "message": "Unauthorized.",
                        "request_id": "req_7c1e9a4b2d3f5a6b8c9d0e1f",
                        "type": "authentication_error"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ImageAPIErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API Key."
          },
          "402": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "error": {
                        "code": "insufficient_balance",
                        "http_status": 402,
                        "message": "Insufficient balance.",
                        "request_id": "req_7c1e9a4b2d3f5a6b8c9d0e1f",
                        "type": "insufficient_balance_error"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ImageAPIErrorResponse"
                }
              }
            },
            "description": "Insufficient balance."
          },
          "429": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "error": {
                        "code": "rate_limit_exceeded",
                        "http_status": 429,
                        "message": "Rate limit exceeded. Please try again later.",
                        "request_id": "req_7c1e9a4b2d3f5a6b8c9d0e1f",
                        "type": "rate_limit_error"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ImageAPIErrorResponse"
                }
              }
            },
            "description": "Too many requests; retry later."
          },
          "502": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "error": {
                        "code": "service_unavailable",
                        "http_status": 502,
                        "message": "Service temporarily unavailable. Please try again later.",
                        "request_id": "req_7c1e9a4b2d3f5a6b8c9d0e1f",
                        "type": "api_error"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ImageAPIErrorResponse"
                }
              }
            },
            "description": "Upstream generation failed (including content moderation refusals). Not charged; you may retry."
          }
        },
        "summary": "Generate content",
        "tags": [
          "Gemini 3.1 Flash Lite Image"
        ],
        "x-mint": {
          "href": "/en/api-reference/gemini-3-1-flash-lite-image/generate-content",
          "metadata": {
            "sidebarTitle": "Generate content",
            "title": "Generate content"
          }
        }
      }
    }
  },
