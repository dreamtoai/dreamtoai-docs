                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/GeminiOmniInteraction"
                }
              }
            },
            "description": "视频已生成。",
            "headers": {
              "X-Request-Id": {
                "description": "请求 Id，排查问题时请提供。",
                "schema": {
                  "type": "string"
